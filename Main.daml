module Main where

template Service
  with
    provider : Party
    customer : Party
  where
    signatory provider
    observer customer
    nonconsuming choice MakeRequest : ContractId Request
      with
        note : Text
      controller customer
      do
        now <- getTime
        create Request with
          provider
          customer
          note
          requestedAt = now

template Request
  with
    provider    : Party
    customer    : Party
    note        : Text
    requestedAt : Time
  where
    signatory provider, customer
