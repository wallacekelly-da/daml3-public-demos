list : SetupResult -> Script ()
list a@(SetupResult {..}) = do

  assetsV1 <- query @V1.Asset alice
  forA_ assetsV1 \(_, asset) -> do
    debugRaw $ "V1 " <> asset.name <> " " <> (show asset.owner)

  assetsV2 <- query @V2.Asset alice
  forA_ assetsV2 \(_, asset) -> do
    debugRaw $ "V2 " <> asset.assetId.name <> " " <> (show asset.owner)

  pure()

give : SetupResult -> Script ()
give a@(SetupResult {..}) = do

  assets <- queryInterface @V2.IAsset alice
  let asset = find (\(cid, Some asset) -> asset.owner /= alice) assets
  case asset of
    Some(cid, Some a) -> do
      debugRaw $ "Giving " <> (show a.assetId.name) <> " to Alice"
      submit a.owner do
        exerciseCmd cid V2.Give with newOwner = alice
      pure()
    _ -> debugRaw "All assets are owned by Alice"
  pure()

data SetupResult = SetupResult with
  alice : Party
  bob : Party
  charlie : Party
  daniel : Party
