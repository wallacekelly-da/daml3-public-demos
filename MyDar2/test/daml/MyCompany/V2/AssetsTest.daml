module MyCompany.V2.AssetsTest where

import Daml.Script
import DA.Foldable(forA_)

import qualified MyCompany.V2.Interfaces as V2

listAssets : SetupResult -> Script ()
listAssets a@(SetupResult {..}) = do

  assets <- queryInterface @V2.IAsset alice
  forA_ assets \(_, Some asset) -> do
    debugRaw $ asset.version <> " " <> asset.assetId.name <> " " <> (show asset.owner)

  pure()

returnAssets : SetupResult -> Script ()
returnAssets a@(SetupResult {..}) = do

  assets <- queryInterface @V2.IAsset alice
  let asset = find (\(cid, Some asset) -> asset.owner /= alice) assets
  case asset of
    Some(cid, Some a) -> do
      debugRaw $ "Returning " <> (show a.assetId.name) <> " to Alice"
      submit a.owner do
        exerciseCmd cid V2.ReturnAsset
      pure()
    _ -> debugRaw "All assets are owned by Alice"
  pure()

data SetupResult = SetupResult with
  alice : Party
  bob : Party
  charlie : Party
  daniel : Party
