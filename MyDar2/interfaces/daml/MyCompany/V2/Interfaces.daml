module MyCompany.V2.Interfaces where

data AssetId = AssetId with
    issuer : Party
    name   : Text
  deriving(Eq, Show)

data AssetView = AssetView with
    assetId : AssetId
    owner   : Party
  deriving(Eq, Show)

interface IAsset where

  viewtype AssetView

  give : Party -> Update (ContractId IAsset)
  revert : Update (ContractId IAsset)

  choice Give : ContractId IAsset
    with newOwner : Party
    controller (view this).owner
    do
      give this newOwner

  choice Revert : ContractId IAsset
    controller (view this).assetId.issuer
    do
      revert this
