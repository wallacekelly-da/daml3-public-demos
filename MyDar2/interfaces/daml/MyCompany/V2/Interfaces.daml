module MyCompany.V2.Interfaces where

data AssetId = AssetId with
    issuer : Party
    name   : Text
  deriving(Eq, Show)

data AssetView = AssetView with
    version : Text
    assetId : AssetId
    owner   : Party
  deriving(Eq, Show)

interface IAsset where

  viewtype AssetView

  giveAsset : Party -> Update (ContractId IAsset)
  returnAsset : Update (ContractId IAsset)

  choice GiveAsset : ContractId IAsset
    with newOwner : Party
    controller (view this).owner
    do
      giveAsset this newOwner

  choice ReturnAsset : ContractId IAsset
    controller (view this).assetId.issuer
    do
      returnAsset this
