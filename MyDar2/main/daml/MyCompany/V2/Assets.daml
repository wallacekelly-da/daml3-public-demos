module MyCompany.V2.Assets where

import MyCompany.V2.Interfaces

template Asset
  with
    assetId : AssetId
    owner  : Party
  where
    ensure assetId.name /= ""
    signatory assetId.issuer
    observer owner

    key assetId : AssetId
    maintainer key.issuer

    interface instance IAsset for Asset where

      view = AssetView with
        version = "V2"
        assetId = assetId
        owner = owner

      giveAsset (newOwner : Party) = do
        cid <- create this with owner = newOwner
        return (toInterfaceContractId cid)

      returnAsset = do
        cid <- create this with owner = assetId.issuer
        return (toInterfaceContractId cid)

