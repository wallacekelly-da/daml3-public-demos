module MyCompany.V1.Assets where

import qualified MyCompany.V2.Interfaces as V2
import qualified MyCompany.V2.Assets as V2

template Asset
  with
    issuer : Party
    owner  : Party
    name   : Text
  where
    ensure name /= ""
    signatory issuer
    observer owner

    choice GiveAsset : ContractId Asset
      with
        newOwner : Party
      controller owner
      do
        -- create this with owner = newOwner
        fail "Upgrade to V2."

    interface instance V2.IAsset for Asset where

      view = V2.AssetView with
        version = "V1"
        assetId = V2.AssetId issuer name
        owner   = owner

      giveAsset (newOwner : Party) = do
        cid <- create V2.Asset with
          assetId = V2.AssetId issuer name
          owner = newOwner
        return $ toInterfaceContractId @V2.IAsset cid

      returnAsset = do
        cid <- create V2.Asset with
          assetId = V2.AssetId issuer name
          owner = this.issuer
        return $ toInterfaceContractId @V2.IAsset cid
