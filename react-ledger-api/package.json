{
  "name": "react-ledger-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:vite dev:canton",
    "build": "daml build --project-root daml/Assets && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:vite": "vite",
    "dev:canton": "cd daml/Assets && DAML_SDK_VERSION=3.4.0-snapshot.20250813.1 daml start --json-api-port 7575",
    "generate:ledger-api-types": "npx openapicmd typegen src/ledger-api-client/openapi.ledger.3.4.0.yaml > src/ledger-api-client/openapi.d.ts"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "js-yaml": "^4.1.0",
    "openapi-client-axios": "^7.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "npm-run-all": "^4.1.5",
    "openapi-typescript": "^7.9.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2"
  }
}