module MyCompany.V1.Assets where

import MyCompany.V1.Interfaces

template Asset
  with
    issuer : Party
    owner  : Party
    name   : Text
  where
    ensure name /= ""
    signatory issuer
    observer owner

    interface instance IAsset for Asset where

      view = AssetView with
        issuer = issuer
        owner  = owner
        name   = name

      give (newOwner : Party) = do
        cid <- create this with owner = newOwner
        return (toInterfaceContractId cid)

