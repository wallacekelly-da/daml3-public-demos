module MyCompany.V1.AssetsTest where

import DA.Foldable(forA_)
import MyCompany.V1.Assets

import Daml.Script

createAsset : Party -> Text -> Script (ContractId Asset)
createAsset issuer name = submit issuer do
  createCmd Asset with
    issuer = issuer
    owner  = issuer
    name   = name

giveAsset : Party -> Party -> (ContractId Asset) -> Script (ContractId Asset)
giveAsset owner newOwner cid =
  submit owner do
    exerciseCmd cid GiveAsset with newOwner = newOwner

setup : Script SetupResult
setup = script do

  alice <- allocatePartyByHint (PartyIdHint "Alice")
  bob <- allocatePartyByHint (PartyIdHint "Bob")
  charlie <- allocatePartyByHint (PartyIdHint "Charlie")
  daniel <- allocatePartyByHint (PartyIdHint "Daniel")

  createAsset alice "TV"
  createAsset alice "VHS"
  createAsset alice "DVD"

  assets <- query @Asset alice
  forA_ assets \(cid, asset) -> do
    case asset.name of
      "TV" -> giveAsset alice bob cid
      "VHS" -> giveAsset alice charlie cid
      "DVD" -> giveAsset alice daniel cid
      _ -> error "Unexpected asset name"

  assets <- query @Asset alice
  forA_ assets \(_, asset) ->
    debugRaw $ "V1 " <> asset.name <> " " <> (show asset.owner)

  pure $ SetupResult alice bob charlie daniel

data SetupResult = SetupResult with
  alice : Party
  bob : Party
  charlie : Party
  daniel : Party

